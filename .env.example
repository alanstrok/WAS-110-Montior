# WAS-110 Monitor - Environment Configuration
# Copy this file to .env and customize

# ===========================================
# WAS-110 CONNECTION (Required)
# ===========================================
SFP_HOST=192.168.11.1
SFP_USER=root
SFP_ROOT_PASSWORD=your_password_here

# ===========================================
# DATA COLLECTION
# ===========================================
# How often to fetch data (seconds)
FETCH_INTERVAL_SECONDS=60

# How many hours of history to keep
HISTORY_HOURS=168

# ===========================================
# ALERT THRESHOLDS
# ===========================================
# CPU Temperature thresholds (°C)
TEMP_WARNING=65
TEMP_CRITICAL=75

# Optical temperature thresholds (°C)
OPTICAL_TEMP_WARNING=55
OPTICAL_TEMP_CRITICAL=65

# RX Power thresholds (dBm) - lower values trigger alerts
RX_POWER_WARNING=-25
RX_POWER_CRITICAL=-28

# TX Power thresholds (dBm) - lower values trigger alerts
TX_POWER_WARNING=-1
TX_POWER_CRITICAL=-3

# ===========================================
# NOTIFICATIONS
# ===========================================
# Enable/disable all notifications
NOTIFICATIONS_ENABLED=false

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_TO=alerts@example.com
SMTP_TLS=true

# --- Generic Webhook ---
WEBHOOK_URL=https://your-webhook-endpoint.com/hook
WEBHOOK_ENABLED=false

# --- Discord ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# --- Ntfy (https://ntfy.sh) ---
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=was110-alerts

# ===========================================
# DEVELOPMENT
# ===========================================
DEBUG=false
PORT=5050
